    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "description": "Patient registration, login, and logout endpoints.",
      "item": [
        {
          "name": "POST Login (Demo Patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Response contains login success and JWT token', function () {",
                  "    pm.expect(jsonData.message).to.eql('Login successful');",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "});",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('JWT Token saved to collection variable {{token}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@patient.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in the pre-seeded demo patient and auto-saves the JWT token to {{token}}."
          }
        },
        {
          "name": "POST Register New Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('New user registered with token', function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.patient.fullName).to.eql('Postman Test User');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Test User\",\n  \"email\": \"postman_patient_1793707729345@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"9876543210\",\n  \"dateOfBirth\": \"1996-05-20\",\n  \"gender\": \"Female\"\n}"
            },
