        {
          "name": "GET Available Slots for Date (?date={{slotDate}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var slots = pm.response.json();",
                  "pm.test('Returns slots array', function () {",
                  "    pm.expect(slots).to.be.an('array');",
                  "});",
                  "var free = slots.filter(s => s.available);",
                  "if (free.length >= 2) {",
                  "    pm.collectionVariables.set('slotId', free[0].id.toString());",
                  "    pm.collectionVariables.set('newSlotId', free[1].id.toString());",
                  "    console.log('Set {{slotId}} to', free[0].id, 'and {{newSlotId}} to', free[1].id);",
                  "} else if (free.length === 1) {",
                  "    pm.collectionVariables.set('slotId', free[0].id.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/doctors/1/slots?date={{slotDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "doctors",
                "1",
                "slots"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{slotDate}}"
                }
              ]
            },
            "description": "Fetches slots for the date and automatically binds available slots to {{slotId}} and {{newSlotId}}."
          }
